# Backend Environment Configuration (.env)
# Rename to .env in your production environment or configure in your cloud host settings.

# Application Environment
FLASK_ENV=production
PORT=5000

# Security: Generate a strong random key (e.g. via `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# Cross-Origin Resource Sharing (CORS)
# Restrict to your frontend production domain(s), comma-separated.
# Example: https://my-course-portal.vercel.app,https://portal.university.edu
CORS_ORIGINS=https://your-frontend-domain.com

# Database Configuration:
# OPTION A: PostgreSQL (Recommended for cloud production: Render, Railway, Supabase, Neon, AWS RDS)
# DATABASE_URL=postgresql://postgres_user:strong_password@ep-example-12345.us-east-2.aws.neon.tech/coursedb?sslmode=require

# OPTION B: SQLite on Persistent Disk (e.g. Docker Volume or persistent VM mount)
# Ensure the directory exists and is writable by the application.
DATABASE_PATH=courses.db

# Initial Administrator Seed Password (used only if database is initialized fresh)
OCR_ADMIN_PASSWORD=change-this-to-a-secure-admin-password
