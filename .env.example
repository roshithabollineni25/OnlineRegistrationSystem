# Root Environment Configuration (.env.example)
# Use this reference when orchestrating frontend and backend together (e.g., via Docker Compose).

# Backend Settings
FLASK_ENV=production
PORT=5000
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
CORS_ORIGINS=http://localhost:5173,https://your-domain.com

# PostgreSQL Connection (or SQLite file path)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coursereg
DATABASE_PATH=backend/courses.db
OCR_ADMIN_PASSWORD=change-this-to-a-secure-admin-password

# Frontend Settings (Build-time)
VITE_API_BASE_URL=http://localhost:5000/api
